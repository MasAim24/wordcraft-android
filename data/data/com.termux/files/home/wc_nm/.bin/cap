#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/data/data/com.termux/files/home/wc_nm/.pnpm/@capacitor+cli@7.6.9/node_modules/@capacitor/cli/node_modules:/data/data/com.termux/files/home/wc_nm/.pnpm/@capacitor+cli@7.6.9/node_modules:/data/data/com.termux/files/home/wc_nm/.pnpm/node_modules"
else
  export NODE_PATH="/data/data/com.termux/files/home/wc_nm/.pnpm/@capacitor+cli@7.6.9/node_modules/@capacitor/cli/node_modules:/data/data/com.termux/files/home/wc_nm/.pnpm/@capacitor+cli@7.6.9/node_modules:/data/data/com.termux/files/home/wc_nm/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@capacitor/cli/bin/capacitor" "$@"
else
  exec node  "$basedir/../@capacitor/cli/bin/capacitor" "$@"
fi
